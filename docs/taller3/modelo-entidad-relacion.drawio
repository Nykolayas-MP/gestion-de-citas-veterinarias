          <mxGeometry y="30" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="mascota" value="MASCOTA" style="swimlane;fontStyle=1;startSize=30;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
