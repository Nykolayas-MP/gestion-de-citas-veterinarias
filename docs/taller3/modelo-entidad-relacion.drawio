          <mxGeometry y="30" width="210" height="115" as="geometry" />
        </mxCell>

        <mxCell id="atencion" value="ATENCIÓN" style="swimlane;fontStyle=1;startSize=30;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="910" y="40" width="210" height="120" as="geometry" />
