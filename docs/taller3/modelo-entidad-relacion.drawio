          <mxGeometry y="30" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="tiene" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.4615;" edge="1" parent="1" source="dueno" target="mascota">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="agenda" style="edgeStyle=none;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4615;entryX=0;entryY=0.4138;" edge="1" parent="1" source="mascota" target="cita">
