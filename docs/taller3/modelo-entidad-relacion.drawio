<mxfile host="app.diagrams.net">
  <diagram id="modelo-er" name="Modelo entidad-relación">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="270" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dueno" value="DUEÑO" style="swimlane;fontStyle=1;startSize=30;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="210" height="120" as="geometry" />
